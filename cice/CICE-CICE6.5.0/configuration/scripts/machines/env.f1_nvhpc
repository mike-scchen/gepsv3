#!/bin/csh -f

source $LMOD_ROOT/lmod/init/csh
# Load NVIDIA HPC SDK 24.11
module purge
module use ${GEPS_DIR}/modulefiles
module load modulefile.tcogfs.gpu
module list

# May be needed for OpenMP memory
#setenv OMP_STACKSIZE 64M

setenv ICE_MACHINE_MACHNAME f1
setenv ICE_MACHINE_MACHINFO "NCHC Forerunner 1"
setenv ICE_MACHINE_ENVNAME nvhpc
setenv ICE_MACHINE_ENVINFO "nvhpc mpi"
setenv ICE_MACHINE_MAKE gmake
setenv ICE_MACHINE_WKDIR ~/CICE_RUNS
setenv ICE_MACHINE_INPUTDATA /home/opd_timcom/model_src/CICE/input_data
setenv ICE_MACHINE_BASELINE ~/CICE_BASELINE
setenv ICE_MACHINE_SUBMIT "sbatch"
setenv ICE_MACHINE_TPNODE 96
setenv ICE_MACHINE_QUEUE "development"
setenv ICE_MACHINE_ACCT "MST113255"
setenv ICE_MACHINE_BLDTHRDS 1
setenv ICE_MACHINE_QSTAT "squeue -u $USER"
