              39                       type(GlobalSegMap), pointer :: srcGSMap, dstGSMap
              40                       type(SparseMatrix), pointer :: remap_sMat
              41                       type(SparseMatrixPlus), pointer :: remap_sMatPlus
              42                     
              43     1                 if(id_src .eq. id_gfs .and. id_dst .eq. id_gocn) then
              44     1                   srcGSMap=>gfsGSMap
              45     1                   dstGSMap=>gocn_in_gfsGSMap
