              89                     subroutine read_SCRIP_file(SCRIP_file, remap_sMat, tag)
              90                       use NETCDF
              91                       implicit none
              92                     
              93                       character(len=*), intent(in) :: SCRIP_file
              94                       type(SparseMatrix), intent(out) :: remap_sMat
              95                       integer, intent(in) :: tag
              96                     
              97                       integer :: ierr, ncid, varid
              98                       integer :: src_dims(2), dst_dims(2), dimIDs(1)
              99                       integer :: num_elems, nRows, nCols
             100                       real(8), pointer :: sparse_weights(:)
             101                       integer, pointer :: sparse_rows(:), sparse_cols(:)
             102                     
             103                       ierr = NF90_OPEN(trim(SCRIP_file), NF90_NOWRITE, ncid)
             104                     
             105                       ierr = NF90_INQ_VARID(ncid, "src_grid_dims", varid)
             106                       ierr = NF90_GET_VAR(ncid, varid, src_dims, (/1/), (/2/))
             107                     
             108                       ierr = NF90_INQ_VARID(ncid, "dst_grid_dims", varid)
             109                       ierr = NF90_GET_VAR(ncid, varid, dst_dims, (/1/), (/2/))
             110                     
             111                       ierr = NF90_INQ_VARID(ncid, "S", varid)
             112                       ierr = NF90_INQUIRE_VARIABLE(ncid, varid, dimids=dimIDs)
             113                       ierr = NF90_INQUIRE_DIMENSION(ncid, dimIDs(1), len=num_elems)
             114                     
             115                       allocate( sparse_weights(num_elems) )
             116                       allocate( sparse_rows(num_elems) )
             117                       allocate( sparse_cols(num_elems) )
             118                     
             119                       ierr = NF90_GET_VAR(ncid, varid, sparse_weights, (/1/), (/num_elems/))
             120                       ierr = NF90_INQ_VARID(ncid, "row", varid)
             121                       ierr = NF90_GET_VAR(ncid, varid, sparse_rows, (/1/), (/num_elems/))
             122                       ierr = NF90_INQ_VARID(ncid, "col", varid)
             123                       ierr = NF90_GET_VAR(ncid, varid, sparse_cols, (/1/), (/num_elems/))
             124                       ierr = NF90_CLOSE(ncid)
             125                     
             126                       nRows = dst_dims(1)*dst_dims(2)
             127                       nCols = src_dims(1)*src_dims(2)
             128                     
             129                       write(*,*) "[CPL]: in read sMat file:", nRows, nCols, tag, num_elems
             130                       call SparseMatrix_init(remap_sMat, nRows, nCols, num_elems)
             131                       write(*,*) "[CPL]: check sMat nRows: ", tag, size(sparse_rows)
             132                       call SparseMatrix_importGRowInd(remap_sMat, sparse_rows,    size(sparse_rows))
             133                       write(*,*) "[CPL]: check sMat nCols: ", tag, size(sparse_cols)
             134                       call SparseMatrix_importGColInd(remap_sMat, sparse_cols,    size(sparse_cols))
             135                       write(*,*) "[CPL]: check sMat nWgts: ", tag, size(sparse_weights)
             136                       call SparseMatrix_importMatElts(remap_sMat, sparse_weights, size(sparse_weights))
             137                     
             138                       deallocate( sparse_weights )
             139                       deallocate( sparse_rows )
             140                       deallocate( sparse_cols )
             141                     end subroutine read_SCRIP_file
             142                     
             143                     end module cpl_smat

