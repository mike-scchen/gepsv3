              29                     subroutine cpl_smat_init(myrank, rank_root, id_src, id_dst, mpi_comm_mct, SCRIP_file)
              30                       use m_GlobalSegMap, only: GlobalSegMap
              31                       use cpl_gsmap
              32                       implicit none
              33                     
              34                       integer, intent(in) :: myrank, rank_root
