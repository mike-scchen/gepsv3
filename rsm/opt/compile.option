#!/bin/sh
# compile options for ibm_xlf, mac_intel, mac_absoft, mac_xlf, linux_pgi, linux_gfortran
#                     mac_gfortran
# if you need to setting DEBUG option, please set it in build.sh.
   export DEBUG=${DEBUG:-no} 

if [ $MACHINE = ibm_xlf ]; then
#### run option for IBM SP #######################################################
   export MP_PULSE=0
   export MP_TIMEOUT=600
   export XLFRTEOPTS="namelist=old"

#### compile option for IBM SP ########################################

   export F_SUBF=f90

   export C_PREP_RMTN=/usr/ccs/lib/cpp
   export F_COMP_RMTN=xlf
   export F_FLAG_RMTN='-qrealsize=8 -qxlf77=leadzero -qmaxmem=-1 -qnosave'
   export F_LINK_RMTN='-qrealsize=8 -qxlf77=leadzero -qmaxmem=-1 -qnosave'
   export F_LIBS_RMTN='-l essl -l mass '

   export C_PREP_RINP=/usr/ccs/lib/cpp
   export F_COMP_RINP=xlf90_r
   export F_COMP_RINP90=xlf90_r
   export F_LINK_RINP='-qrealsize=8 -qxlf77=leadzero -qmaxmem=-1 -qnosave'
   mach_name=`uname -a | cut -c5`
# cirrus
   if [ $mach_name = c ]; then
     export F_FLAG_RINP='-qrealsize=8 -qxlf77=leadzero -qmaxmem=-1 -qnosave -I/nwprod/lib/incmod/g2_4'
     export F_LIBS_RINP='-l essl -l mass  -L/nwprod/lib -lg2_4 -lw3_d -lbacio_4 -L/usrx/local/64bit.cirrus/lib -ljasper -lpng -lz'
   fi
# stratus
   if [ $mach_name = s ]; then
     export F_FLAG_RINP='-qrealsize=8 -qxlf77=leadzero -qmaxmem=-1 -qnosave -I/nwprod/lib/incmod/g2_4'
     export F_LIBS_RINP='-l essl -l mass  -L/nwprod/lib -lg2_4 -lw3_d -lbacio_4 -L/usrx/local/64bit.cirrus/lib -ljasper -lpng -lz'
   fi
# vapor  
   if [ $mach_name = v ]; then
     export F_FLAG_RINP='-qrealsize=8 -qxlf77=leadzero -qmaxmem=-1 -qnosave -I${DISK}/lib/incmod/g2_4'
     export F_LIBS_RINP='-l essl -l mass  -L${DISK}/lib -lg2_4 -lw3_d -lbacio_4 -ljasper -lpng -lz'
   fi

   export C_PREP_FCST=/usr/ccs/lib/cpp
   export F_COMP_FCST=mpxlf90
   export F_COMP_FCST90=mpxlf90
   export F_FLAG_FCST='-O3 -qsource -qrealsize=8 -qstrict -qxlf77=leadzero -qmaxmem=-1 -qnosave -qsmp=noauto -bloadmap:rsm_err'
   export F_LINK_FCST='-O3 -qsource -qrealsize=8 -qstrict -qxlf77=leadzero -qmaxmem=-1 -qnosave -qsmp=noauto -bloadmap:rsm_err'
   export F_LIBS_FCST='-lessl -lmass -L/usrx/local/mpi_trace/lib -lmpitrace_smp'

   export C_PREP_POST=/usr/ccs/lib/cpp
   export F_COMP_POST=xlf
   export F_FLAG_POST='-Q -O3   -qxlf77=leadzero -qmaxmem=-1 -qnosave'
   export F_LINK_POST='-Q -O3   -qxlf77=leadzero -qmaxmem=-1 -qnosave'
   export F_LIBS_POST='-l essl -l mass -L/nwprod/lib -lbacio_4 -lw3_4'

   export C_PREP=/usr/ccs/lib/cpp
   export F_COMP=xlf
   export F_FLAG_r8='-qrealsize=8'
   export F_FLAG=' '
   if [ $DEBUG = yes ]; then
   export F_FLAG='-O -qieee -qstrict -qsource -qxref=full -qattr=full -qflttrap=ov:und:zero:inv:en -qsigtrap -qcheck -qextchk -qinitauto=FF'
   fi
#   export F_FLAG='-qrealsize=8 -O -qieee -qstrict -qsource -qxref=full -qattr=full -qflttrap=ov:und:nanq:zero:inv:en -qsigtrap -qcheck -qextchk -qinitauto=FF'
   export F_LIBS='-lessl'

elif [ $MACHINE = mac_intel ]; then

######### Mac mini INTEL FORTRAN compiler for INTEL CORE DUO #######

   export F_SUBF=f90

   export C_PREP_RMTN=cpp
   export F_COMP_RMTN=ifort
   export F_FLAG_RMTN='-r8 -convert big_endian -auto '
   export F_LINK_RMTN='-r8 -convert big_endian -auto '
   export F_LIBS_RMTN=

   export C_PREP_RINP=cpp
   export F_COMP_RINP=ifort
   export F_COMP_RINP90=ifort
   export F_FLAG_RINP='-r8 -convert big_endian -auto -I${DISK}/lib/incmod/g2_4'
   export F_LINK_RINP='-r8 -convert big_endian -auto -I${DISK}/lib/incmod/g2_4'
   export F_LIBS_RINP=
   export F_LIBS_RINP='-L${DISK}/lib -lg2_4 -lw3_d -lbacio_4 -L/usr/local -ljasper -lpng -lz'

   export C_PREP_FCST=cpp
   export F_COMP_FCST=ifort
   export F_COMP_FCST=mpif77
   export F_COMP_FCST90=ifort
   export F_COMP_FCST90=mpif77
   export F_FLAG_FCST='-r8 -convert big_endian -auto '
   export F_LINK_FCST='-r8 -convert big_endian -auto '
   export F_LIBS_FCST=

   export C_PREP_POST=cpp
   export F_COMP_POST=ifort
   export F_FLAG_POST='-convert big_endian -auto '
   export F_LINK_POST='-convert big_endian -auto '
   export F_LIBS_POST=

   export C_PREP=cpp
   export F_COMP=ifort
   export F_FLAG_r8='-r8 -convert big_endian -auto '
   export F_FLAG='-convert big_endian -auto '

elif [ $MACHINE = linux_intel ]; then

   export F_SUBF=f90

#ch   export C_PREP_RMTN='cpp -C'
   export C_PREP_RMTN='cpp -traditional-cpp'
   export F_COMP_RMTN=ifort
   export F_FLAG_RMTN='-r8 -convert big_endian -mcmodel=large'
   export F_LINK_RMTN='-r8 -convert big_endian -mcmodel=large'
   export F_LIBS_RMTN=

   export C_PREP_3DRT='cpp -traditional-cpp'
   export F_COMP_3DRT=ifort
   export F_FLAG_3DRT='-r8 -convert big_endian -mcmodel=large -I${DISK}/lib/netcdf-4.1.3/include'
   export F_LINK_3DRT='-r8 -convert big_endian -mcmodel=large -I${DISK}/lib/netcdf-4.1.3/include'
#   export F_LIBS_3DRT='-L${DISK}/lib/netcdf-3.6.3/lib -lnetcdf'
   export F_LIBS_3DRT='-L${DISK}/lib/netcdf-4.1.3/lib -lnetcdff -lnetcdf'

   export C_PREP_RINP='icc -C -E'
   export F_COMP_RINP=ifort
   export F_COMP_RINP90=ifort
#yj:notused   export F_FLAG_RINP='-r8 -convert big_endian -mcmodel=large -shared-intel -I${DISK}/lib/incmod/g2_4'
#yj:notused   export F_LINK_RINP='-r8 -convert big_endian -mcmodel=large -shared-intel -I${DISK}/lib/incmod/g2_4'

#  export F_LIBS_RINP='-L${DISK}/lib -lg2_4 -lw3_d -lbacio_4 -L/usr/lib64 -ljasper -lpng -lz'
   export JPATH=${DISK}/lib/jasper-1.900.1/lib
   export PPATH=${DISK}/lib/libpng-1.2.50/lib
   export ZPATH=${DISK}/lib/zlib-1.2.8/lib
   export F_LIBS_RINP='-L${DISK}/lib/NCEPLIB/lib -lg2_v3.1.0_4 -lw3emc_d -lw3nco_d -lw3nco_4 -lbacio_4 -L${JPATH} -ljasper -L${PPATH} -lpng -L${ZPATH} -lz'

   export TIMCOM_PATH=/nwpr/gfs/xb157/CWBSUMc2/components/timcom_tai/src_lib_new
   export PNETCDF=/nwpr/gfs/xb124/package/$(MACHINE)/pnetcdf-1.12.3
   export MKL=/opt/ohpc/Taiwania3/pkg/intel/2020/compilers_and_libraries_2020.4.304/linux/mkl/lib/intel64

   export C_PREP_FCST='cpp -traditional-cpp'
   export F_COMP_FCST=ifort
   export F_COMP_FCST='mpiifort'
   export F_COMP_FCST90=ifort
   export F_COMP_FCST90='mpiifort'
   export F_FLAG_FCST='-O3 -r8 -mcmodel=large -shared-intel -convert big_endian -auto -parallel -qno-opt-matmul'

#debugfinal    export F_FLAG_FCST='-g -O0 -check -traceback -r8 -mcmodel=large -shared-intel -convert big_endian'
#debug    export F_FLAG_FCST='-g -O0 -check all -traceback -fp-stack-check -init=snan  -r8 -mcmodel=large -shared-intel -convert big_endian'
#debug    export F_FLAG_FCST='-g -O0 -fp-stack-check -init=zero -init=snan -init=arrays -mcmodel=large -shared-intel -r8 -convert big_endian'
#debug   export F_FLAG_FCST='-g -O0 -check all -traceback  -fp-stack-check -init=snan,arrays -mcmodel=large -shared-intel -r8 -convert big_endian'
   export F_LINK_FCST='-r8 -convert big_endian -mcmodel=large -shared-intel'
   export F_LIBS_FCST='-qno-opt-matmul -L${DISK}/lib/cwb_mpmd -lmpmd -L${TIMCOM_PATH} -L${NETCDF}/lib -L${PNETCDF}/lib -ltimcom -lpnetcdf -lnetcdff -lnetcdf -ldl -lm -lz -lcurl -lmkl_intel_lp64 -lmkl_sequential -lmkl_core -lpthread'

   export C_PREP_POST='cpp -C'
   export F_COMP_POST=ifort
   export F_FLAG_POST='-convert big_endian  '
   export F_LINK_POST='-convert big_endian  '
   export F_LIBS_POST=

   export C_PREP='cpp -C'
   export F_COMP=ifort
   export F_FLAG_r8='-r8 -convert big_endian  '
   export F_FLAG='-convert big_endian  '

elif [ $MACHINE = mac_gfortran ]; then

######### gfortran #######

   export F_SUBF=f90

   export C_PREP_RMTN=cpp 
   export F_COMP_RMTN=gfortran
   export F_FLAG_RMTN='-O3 -fdefault-real-8 -fconvert=big-endian'
   export F_LINK_RMTN='-O3 -fdefault-real-8 -fconvert=big-endian'
   export F_LIBS_RMTN='-L/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX10.9.sdk/usr/lib/'

   export C_PREP_RINP=cpp
   export F_COMP_RINP=gfortran
   export F_COMP_RINP90=gfortran
   export F_FLAG_RINP='-O3 -fdefault-real-8 -fconvert=big-endian -I${DISK}/lib/incmod/g2_4'
   export F_LINK_RINP='-O3 -fdefault-real-8 -fconvert=big-endian'
   export F_LIBS_RINP='-L${DISK}/lib -lg2_4 -lw3_d -lbacio_4 -ljasper -lpng -lz -L/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX10.9.sdk/usr/lib/'

   export C_PREP_FCST=cpp
   export F_COMP_FCST=gfortran
   export F_COMP_FCST=mpif90
   export F_COMP_FCST90=gfortran
   export F_COMP_FCST90=mpif90
   export F_FLAG_FCST='-O3 -fdefault-real-8 -fconvert=big-endian'
   export F_LINK_FCST='-O3 -fdefault-real-8 -fconvert=big-endian'
   export F_LIBS_FCST='-L/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX10.9.sdk/usr/lib/'

   export C_PREP_POST=cpp
   export F_COMP_POST=gfortran
   export F_FLAG_POST='-O3 -fconvert=big-endian'
   export F_LINK_POST='-O3 -fconvert=big-endian'
   export F_LIBS_POST='-L/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX10.9.sdk/usr/lib/'

   export C_PREP=cpp
   export F_COMP=gfortran
   export F_FLAG_r8='-O3 -fdefault-real-8 -fconvert=big-endian -L/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX10.9.sdk/usr/lib/'
   export F_FLAG='-g -O3 -fconvert=big-endian -L/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX10.9.sdk/usr/lib/'
   if [ $DEBUG = yes ]; then 
   export F_FLAG='-g -fbounds-check -Wuninitialized -O -finit-real=nan -ffpe-trap=invalid,zero,overflow -fconvert=big-endian'
   fi

elif [ $MACHINE = mac_absoft ]; then

######### Mac ProFORTRAN compiler for G4 ###############

   export F_SUBF=f90

   export C_PREP_RMTN=cpp
# export C_PREP_RMTN="$DISK/utl/cppmac -E"
   export F_COMP_RMTN=f90
   export F_FLAG_RMTN='-O -N113 -YNO_CDEC -m4 -cpu:g5 -lU77'
   export F_LINK_RINP="-O -N113 -YNO_CDEC -m4 -cpu:g5 "
   export F_LIBS_RMTN='-lU77'

   export C_PREP_RINP=cpp
   export F_COMP_RINP=f90
   export F_FLAG_RINP='-O -N113 -YNO_CDEC -m4 -cpu:g5 -lU77 -p${DISK}/lib/incmod/g2_4'
   export F_LINK_RINP="-O -N113 -YNO_CDEC -m4 -cpu:g5 "
   export F_LIBS_RINP="-lU77 -L${DISK}/lib -lg2_4 -lw3_d -lbacio_4 -ljasper -lpng -lz"

   export C_PREP_FCST=cpp
   export F_COMP_FCST=mpif77
   export F_FLAG_FCST='-O3 -N113 -YNO_CDEC -m4 -cpu:g5 '
   export F_LINK_FCST=' -O3 -N113 -YNO_CDEC -m4 -cpu:g5 '
   export F_LIBS_FCST_SGL=
   export F_LIBS_FCST=
   export F_LIBS_FCST="-L$DISK/lib -lbacio_4 -lw3_d"
   export F_W3LB_FCST=" "

   export C_PREP_POST=cpp
   export F_COMP_POST=f90
   export F_FLAG_POST="-O -YNO_CDEC -m4 -cpu:g5 -lU77"
   export F_LINK_POST="-O -YNO_CDEC -m4 -cpu:g5 -lU77"
   export F_LIBS_POST="-L$DISK/lib -lbacio_4 -lw3_4"

   export C_PREP=cpp
   export F_COMP=f90
   export F_FLAG_r8='-N113 -YNO_CDEC -m4 -cpu:g5 -lU77'
   export F_FLAG='-YNO_CDEC -m4 -cpu:g5 -lU77'

elif [ $MACHINE = mac_xlf ]; then

######### Mac ibm xlf FORTRAN compiler for G4 ###############

   export F_SUBF=f90

   export C_PREP_RMTN=/opt/ibmcmp/xlf/8.1/exe/cpp
   export F_COMP_RMTN=xlf90
   export F_FLAG_RMTN='-qsuffix=f=f90 -qrealsize=8'
   export F_LINK_RMTN='-qsuffix=f=f90 -qrealsize=8'
   export F_LIBS_RMTN=

   export C_PREP_RINP=/opt/ibmcmp/xlf/8.1/exe/cpp
   export F_COMP_RINP=xlf90
   export F_FLAG_RINP='-qsuffix=f=f90 -qrealsize=8 -I${DISK}/lib/incmod/g2_4'
   export F_LINK_RINP='-qsuffix=f=f90 -qrealsize=8'
   export F_LIBS_RINP="-L${DISK}/lib -lg2_4 -lw3_d -lbacio_4 -ljasper -lpng -lz"

   export C_PREP_FCST=/opt/ibmcmp/xlf/8.1/exe/cpp
#  export F_COMP_FCST=xlf90
   export F_COMP_FCST=mpif77
   export F_FLAG_FCST='-qsuffix=f=f90 -qrealsize=8'
   export F_LINK_FCST='-qsuffix=f=f90 -qrealsize=8'
   export F_LIBS_FCST=

   export C_PREP_POST=/opt/ibmcmp/xlf/8.1/exe/cpp
   export F_COMP_POST=xlf90
   export F_FLAG_POST='-qsuffix=f=f90'
   export F_LINK_POST='-qsuffix=f=f90'
   export F_LIBS_POST=

   export C_PREP=/opt/ibmcmp/xlf/8.1/exe/cpp
   export F_COMP=xlf90
   export F_FLAG_r8='-qrealsize=8'
   export F_FLAG=

elif [ $MACHINE = linux_pgi ]; then

   export F_SUBF=f90

########### compile option for LINUX PGI compiler ##################

   export C_PREP='cc -E'
   export F_COMP=pgf90
   export F_FLAG_r8='-g -r8 -byteswapio '
   export F_FLAG='-O3 -g -byteswapio '
   export F_LINK='-O3 -g -byteswapio '
   export F_LIBS='-llapack -lblas'

   export C_PREP_RMTN=' cpp -C '
   export F_COMP_RMTN=pgf90
   export F_FLAG_RMTN='-r8 -byteswapio '
   export F_LINK_RMTN='-r8 -byteswapio '
   export F_LIBS_RMTN=

   export C_PREP_RINP=' cpp -C '
   export F_COMP_RINP=pgf90
   export F_COMP_RINP90=pgf90
   export F_FLAG_RINP='-r8 -byteswapio -I${DISK}/lib/incmod/g2_4 '
   export F_LINK_RINP='-r8 -byteswapio '
   export F_LIBS_RINP=
   export F_LIBS_RINP="-L${DISK}/lib -lg2_4 -lw3_d -lbacio_4 -ljasper -lpng -lz"

   export C_PREP_FCST=' cpp -C '
   export F_COMP_FCST=pgf90
   export F_COMP_FCST=mpif90
   export F_COMP_FCST90=pgf90
   export F_COMP_FCST90=mpif90
   export F_FLAG_FCST='-r8 -byteswapio '
   export F_LINK_FCST='-r8 -byteswapio '
   export F_LIBS_FCST=

   export C_PREP_POST=' cpp -C '
   export F_COMP_POST=pgf90
   export F_FLAG_POST='-byteswapio '
   export F_LINK_POST='-byteswapio '
   export F_LIBS_POST=

elif [ $MACHINE = linux_gfortran ]; then

######### gfortran #######

   export F_SUBF=f90

   export C_PREP_RMTN='cpp -C'
   export F_COMP_RMTN=gfortran
   export F_FLAG_RMTN='-O3 -fdefault-real-8 -fconvert=big-endian'
   export F_LINK_RMTN='-O3 -fdefault-real-8 -fconvert=big-endian'
   export F_LIBS_RMTN=

   export C_PREP_RINP='cpp -C'
   export F_COMP_RINP=gfortran
   export F_COMP_RINP90=gfortran
   export F_FLAG_RINP='-O3 -fdefault-real-8 -fconvert=big-endian -I${DISK}/lib/incmod/g2_4'
   export F_LINK_RINP='-O3 -fdefault-real-8 -fconvert=big-endian'
#   export F_FLAG_RINP='-O3 -fdefault-real-8 -I${DISK}/lib/incmod/g2_4'
#   export F_LINK_RINP='-O3 -fdefault-real-8 '
#export F_LIBS_RINP='-L${DISK}/lib -lg2_4 -lw3_d -lbacio_4 -ljasper -lpng${DISK}/lib/libpng12.a -lz'
   export F_LIBS_RINP='-L${DISK}/lib -lg2_4 -lw3_d -lbacio_4 -ljasper -lpng -lz'

   export C_PREP_FCST='cpp -C'
   export F_COMP_FCST=gfortran
   export F_COMP_FCST=mpif90
   export F_COMP_FCST90=gfortran
   export F_COMP_FCST90=mpif90
   export F_FLAG_FCST='-O3 -fdefault-real-8 -fconvert=big-endian'
   export F_LINK_FCST='-O3 -fdefault-real-8 -fconvert=big-endian'
   export F_LIBS_FCST=

   export C_PREP_POST='cpp -C'
   export F_COMP_POST=gfortran
   export F_FLAG_POST='-O3 -fconvert=big-endian'
   export F_LINK_POST='-O3 -fconvert=big-endian'
   export F_LIBS_POST=

   export C_PREP='cpp -C'
   export F_COMP=gfortran
   export F_FLAG_r8='-O3 -fdefault-real-8 -fconvert=big-endian'
   export F_FLAG='-g -O3 -fconvert=big-endian'
   if [ $DEBUG = yes ]; then 
   export F_FLAG='-g -fbounds-check -Wuninitialized -O -finit-real=nan -ffpe-trap=invalid,zero,overflow -fconvert=big-endian'
   fi
   export F_LIBS='-llapack -lblas'


elif [ $MACHINE = Fujitsu_fx10 ]; then

########### compile option for Fujitsu fx10 compiler ##################
   
   export F_SUBF=f90
   export C_PREP_RMTN='cpp -C'
   export F_COMP_RMTN=frtpx
   export F_FLAG_RMTN='-O3 -Kfast -CcdRR8'
   export F_LINK_RMTN='-O3 -Kfast -CcdRR8'
   export F_LIBS_RMTN=

   export C_PREP_3DRT='cpp -C'
   export F_COMP_3DRT=frtpx
   export F_FLAG_3DRT='-O3 -Kfast -CcdRR8 -I${DISK}/lib/netcdf-4.1.3/include'
   export F_LINK_3DRT='-O3 -Kfast -CcdRR8 -I${DISK}/lib/netcdf-4.1.3/include'
   export F_LIBS_3DRT='-L${DISK}/lib/netcdf-4.1.3/lib -lnetcdf'

   export C_PREP_RINP='cpp -C'
   export F_COMP_RINP=frtpx
   export F_COMP_RINP90=frtpx
#yj:notused   export F_FLAG_RINP='-O3 -Kfast -CcdRR8 -I${DISK}/lib/incmod/g2_4'
#yj:notused   export F_LINK_RINP='-O3 -Kfast -CcdRR8'
#   export F_LIBS_RINP='-Kopenmp -SSL2BLAMP -L${DISK}/lib -lg2_4 -lw3_d -lbacio_4 -ljasper -lpng -lz'
   export JPATH=/package/fx10/jasper-1.900.1/lib
   export PPATH=/package/fx10/libpng-1.2.50/lib
   export ZPATH=/users/xa09/fx10/zlib-1.2.8/lib
   export F_LIBS_RINP='-Kopenmp -SSL2BLAMP -L${DISK}/lib/NCEPLIB/lib -lg2_v3.1.0_4 -lw3emc_d -lw3nco_d -lw3nco_4 -lbacio_4 -L${JPATH} -ljasper -L${PPATH} -lpng -L${ZPATH} -lz'

   export C_PREP_FCST='cpp -C'
   export F_COMP_FCST=mpifrtpx
   export F_COMP_FCST90=mpifrtpx
   export F_FLAG_FCST='-fw -Kfast,openmp,ocl,autoobjstack -CcdRR8 -Ec -Qa,d,p,t,x -Koptmsg=2'
   export F_LINK_FCST='-O3 -Kfast,parallel -CcdRR8'
   export F_LIBS_FCST='-L${DISK}/lib/cwb_mpmd -lmpmd -Kopenmp -SSL2BLAMP'

   export C_PREP_POST='cpp -C'
   export F_COMP_POST=frtpx
   export F_FLAG_POST='-O3 -Kfast'
   export F_LINK_POST='-O3 -Kfast'
   export F_LIBS_POST=

   export C_PREP='cpp -C'
   export F_COMP=frtpx
   export F_FLAG_r8='-O3 -Kfast -CcdRR8'
   export F_FLAG='-g -O3 -Kfast'
   if [ $DEBUG = yes ]; then
   export F_FLAG='-g -fbounds-check -Wuninitialized -O -Kfast -finit-real=nan -ffpe-trap=invalid,zero,overflow'
   fi
   export F_LIBS='-llapack -lblas'

elif [ $MACHINE = Fujitsu_fx100 ]; then

########### compile option for Fujitsu fx10 compiler ##################
   
   export F_SUBF=f90
   export C_PREP_RMTN='cpp -C'
   export F_COMP_RMTN=frtpx100
   export F_FLAG_RMTN='-O3 -Kfast -CcdRR8'
   export F_LINK_RMTN='-O3 -Kfast -CcdRR8'
   export F_LIBS_RMTN=

   export C_PREP_3DRT='cpp -C'
   export F_COMP_3DRT=frtpx100
   export F_FLAG_3DRT='-O3 -Kfast -CcdRR8 -I${DISK}/lib/netcdf-3.6.3/include'
   export F_LINK_3DRT='-O3 -Kfast -CcdRR8 -I${DISK}/lib/netcdf-3.6.3/include'
   export F_LIBS_3DRT='-L${DISK}/lib/netcdf-3.6.3/lib -lnetcdf'

   export C_PREP_RINP='cpp -C'
   export F_COMP_RINP=frtpx100
   export F_COMP_RINP90=frtpx100
#yj:notused   export F_FLAG_RINP='-O3 -Kfast -CcdRR8 -I${DISK}/lib/incmod/g2_4'
#yj:notused   export F_LINK_RINP='-O3 -Kfast -CcdRR8'
#   export F_LIBS_RINP='-Kopenmp -SSL2BLAMP -L${DISK}/lib -lg2_4 -lw3_d -lbacio_4 -ljasper -lpng -lz'
   export JPATH=/package/fx100/jasper-1.900.1/lib
   export PPATH=/package/fx100/libpng-1.2.50/lib
   export ZPATH=/users/xa09/fx100/zlib-1.2.8/lib
   export F_LIBS_RINP='-Kopenmp -SSL2BLAMP -L${DISK}/lib/NCEPLIB/lib -lg2_v3.1.0_4 -lw3emc_d -lw3nco_d -lw3nco_4 -lbacio_4 -L${JPATH} -ljasper -L${PPATH} -lpng -L${ZPATH} -lz'

   export C_PREP_FCST='cpp -C'
   export F_COMP_FCST=mpifrtpx100
   export F_COMP_FCST90=mpifrtpx100
   export F_FLAG_FCST='-fw -Kfast,openmp,ocl,autoobjstack -CcdRR8 -Ec -Qa,d,p,t,x -Koptmsg=2'
   export F_LINK_FCST='-O3 -Kfast,parallel -CcdRR8'
   export F_LIBS_FCST='-L${DISK}/lib/cwb_mpmd -lmpmd -Kopenmp -SSL2BLAMP'

   export C_PREP_POST='cpp -C'
   export F_COMP_POST=frtpx100
   export F_FLAG_POST='-O3 -Kfast'
   export F_LINK_POST='-O3 -Kfast'
   export F_LIBS_POST=

   export C_PREP='cpp -C'
   export F_COMP=frtpx100
   export F_FLAG_r8='-O3 -Kfast -CcdRR8'
   export F_FLAG='-g -O3 -Kfast'
   if [ $DEBUG = yes ]; then
   export F_FLAG='-g -fbounds-check -Wuninitialized -O -Kfast -finit-real=nan -ffpe-trap=invalid,zero,overflow'
   fi
   export F_LIBS='-llapack -lblas'

elif [ $MACHINE = Fujitsu_fx1000 ]; then

########### compile option for Fujitsu fx10 compiler ##################
   
   export F_SUBF=f90
   export C_PREP_RMTN='cpp -C'
   export F_COMP_RMTN=frtpx
   export F_FLAG_RMTN='-O3 -Kfast -CcdRR8'
   export F_LINK_RMTN='-O3 -Kfast -CcdRR8'
   export F_LIBS_RMTN=

   export C_PREP_3DRT='cpp -C'
   export F_COMP_3DRT=frtpx
   export F_FLAG_3DRT='-O3 -Kfast -CcdRR8 -I${DISK}/lib/netcdf-3.6.3/include'
   export F_LINK_3DRT='-O3 -Kfast -CcdRR8 -I${DISK}/lib/netcdf-3.6.3/include'
   export F_LIBS_3DRT='-L${DISK}/lib/netcdf-3.6.3/lib -lnetcdf'

   export C_PREP_RINP='cpp -C'
   export F_COMP_RINP=frtpx
   export F_COMP_RINP90=frtpx
#yj:notused   export F_FLAG_RINP='-O3 -Kfast -CcdRR8 -I${DISK}/lib/incmod/g2_4'
#yj:notused   export F_LINK_RINP='-O3 -Kfast -CcdRR8'
#   export F_LIBS_RINP='-Kopenmp -SSL2BLAMP -L${DISK}/lib -lg2_4 -lw3_d -lbacio_4 -ljasper -lpng -lz'
   export JPATH=${DISK}/lib/jasper-1.900.1/lib
   export PPATH=${DISK}/lib/libpng-1.6.37/lib
   export ZPATH=${DISK}/lib/zlib-1.2.3/lib
   export F_LIBS_RINP='-Kopenmp -SSL2BLAMP -L${DISK}/lib/NCEPLIB/lib -lg2_v3.1.0_4 -lw3emc_d -lw3nco_d -lw3nco_4 -lbacio_4 -L${JPATH} -ljasper -L${PPATH} -lpng -L${ZPATH} -lz'

   export NETCDF_PATH=/package/fx1000/netcdf-4.1.3/lib
   export PNETCDF_PATH=/nwpr/gfs/xb124/package/fx1000/pnetcdf-1.12.3/lib
   export HDF5_PATH=/package/fx1000/hdf5-1.8.22/lib
   export TIMCOM_PATH=/nwpr/gfs/xb157/CWBSUMc2/components/timcom_tai/src_lib_new

   export C_PREP_FCST='cpp -C'
   export F_COMP_FCST=mpifrtpx
   export F_COMP_FCST90=mpifrtpx
   export F_FLAG_FCST='-fw -Kfast,openmp,ocl,autoobjstack -CcdRR8 -Ec -Nlst=a,lst=d,lst=p,lst=t,lst=x -Koptmsg=2'
   export F_LINK_FCST='-O3 -Kfast,parallel -CcdRR8'
   export F_LIBS_FCST='-L${DISK}/lib/cwb_mpmd -lmpmd -Kopenmp -SSL2BLAMP -L${TIMCOM_PATH} -L${NETCDF_PATH} -L${PNETCDF_PATH} -L${HDF5_PATH} -L${ZPATH} -ltimcom -lpnetcdf -lnetcdff -lnetcdf -lhdf5_hl -lhdf5 -lz'
#   export F_LIBS_FCST='-L${DISK}/lib/cwb_mpmd -lmpmd -Kopenmp -SSL2BLAMP -L${TIMCOM_PATH} -L${NETCDF_PATH} -L${PNETCDF_PATH} -L${HDF5_PATH} -L${ZPATH} -ltimcom -lpnetcdf -lnetcdff -lnetcdf -lz'

   #  export F_LIBS_FCST='-Kopenmp -SSL2BLAMP'

   export C_PREP_POST='cpp -C'
   export F_COMP_POST=frtpx
   export F_FLAG_POST='-O3 -Kfast'
   export F_LINK_POST='-O3 -Kfast'
   export F_LIBS_POST=

   export C_PREP='cpp -C'
   export F_COMP=frtpx
   export F_FLAG_r8='-O3 -Kfast -CcdRR8'
   export F_FLAG='-g -O3 -Kfast'
   if [ $DEBUG = yes ]; then
#   export F_FLAG='-g -fbounds-check -Wuninitialized -O -Kfast -finit-real=nan -ffpe-trap=invalid,zero,overflow'
   export F_FLAG='-g -Nquickdbg=argchk -Nquickdbg=undefnan -Nquickdbg=subchk -Nquickdbg=undef -NRtrap'
   fi
   export F_LIBS='-llapack -lblas'

else
   echo " can't support your machine "
   echo " only support ibm_xlf, mac_intel, mac_absoft, mac_xlf, linux_pgi, linux_gfortran "
   echo " you need edit ${UTL}/compile.option "
   exit
fi
