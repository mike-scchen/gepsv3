COUPLERPATH  = $(GEPS_LIBS)/x86_64/nvidia/coupler
TIMCOMLIBPATH = ../timcom_glb/build_gpu/src
CWBGFSLIBPATH = ../tco639l72/build_gpu/lib
TAILIBPATH   = ../rsm/src/timcom.fd
RSMLIBPATH   = ../rsm/run/exe
MCTPATH      = $(GEPS_LIBS)/x86_64/nvidia/mct-2.11.0
HDF5         = $(GEPS_LIBS)/x86_64/nvidia/hdf5-1.13.2
ZLIB         = $(GEPS_LIBS)/x86_64/zlib-1.2.11
PNETCDF      = $(GEPS_LIBS)/x86_64/nvidia/pnetcdf-1.12.3
NETCDF       = $(GEPS_LIBS)/x86_64/nvidia/netcdf-4.9.0
FFTW         = /usr/lib64
FFTW_INC     = /usr/include
W3           = $(GEPS_LIBS)/x86_64/w3lib-2.0.2
OPER         = $(GEPS_LIBS)/x86_64/operlib
DMS          = $(GEPS_LIBS)/x86_64/dms38key
### This assumes you use default module files in NVHPC
### which exports NVHPC_ROOT
CUDA         = $(NVHPC_ROOT)/cuda/12.2.2
CUDA2        = $(NVHPC_ROOT)/cuda/12.2.2/lib64/stubs
#CUDA         = /package/x86_64/nvidia/cuda/12.2.2
#CUDA2        = /package/x86_64/nvidia/cuda/12.2.2/lib64/stubs
NVF          = $(NVHPC_ROOT)/compilers
#NVF          = /package/x86_64/nvidia/hpc_sdk/Linux_x86_64/24.11/compilers
NCCL         = $(NVHPC_ROOT)/nccl
#NCCL         = /package/x86_64/nvidia/hpc_sdk/Linux_x86_64/24.11/comm_libs/nccl
PKG          = /nwpr/gfs/xb157/pkg

PPATH        = $(GEPS_LIBS)/x86_64/libpng-1.6.37/lib -lpng
JPATH        = $(GEPS_LIBS)/x86_64/nvidia/jasper-1.900.1/lib -ljasper
NPATH        = $(GEPS_LIBS)/x86_64/nvidia/g2lib-1.4.0_cwb/lib -lg2

WPATH        = $(GEPS_LIBS)/x86_64/nceplibs/lib -lw3emc_d -lw3nco_d -lw3nco_4 -lbacio_4

F90COMPILER  = /IFS/package/x86_64/nvidia/hpc_sdk/Linux_x86_64/24.11/comm_libs/12.6/hpcx/hpcx-2.20/ompi/bin/mpif90
F90LINKER    = $(F90COMPILER)

INCLUDE      = -I${FFTW_INC} -I${NETCDF}/include -I${COUPLERPATH} -I${MCTPATH}/include

LIBS         = -L${NPATH} -L${PPATH} -L${WPATH} -L${JPATH} \
               -L${PNETCDF}/lib -lpnetcdf -L${NETCDF}/lib -lnetcdf -lnetcdff \
               -L${W3}/lib -L${DMS}/lib -lrdms -lgdbm -L${OPER}/lib -L${FFTW} -lfftw3 -lfftw3f -lfftw3_threads \
               -L${HDF5}/lib -L${ZLIB}/lib -L$(MCTPATH)/lib -L$(PKG)/lib -lrpc -L/lib64/ -ltirpc

FFLAGS_COM   = -O3 -Mpreprocess -Minfo=all -fast -mp -cuda -cudalib -acc

F90COMPILEOPTS = ${FFLAGS_COM} ${LIBS_COM} ${OMP_COM} ${DEFINE_FLAGS} ${MSG_COM}
F90COMPILEPATHS = $(INCLUDE)
F90COMPILECPPFLAGS =
F90LINKOPTS  = ${FFLAGS_COM} ${LIBS_COM} ${OMP_COM} ${DEFINE_FLAGS} ${MSG_COM}

ifeq ($(FRAME), 4cpl)
    F90LINKPATHS = -L${TIMCOMLIBPATH} -ltimcom \
                   -L${CWBGFSLIBPATH} -ltcogfs \
                   -L${RSMLIBPATH} -lrsm4cpl \
                   -L${TAILIBPATH} -ltimcom_tai \
                   -L${COUPLERPATH} -lcpl ${LIBS}
    DRIVER_SRC = driver_gpu_4cpl_TCo383.F90
else ifeq ($(FRAME), 2cpl)
    F90LINKPATHS = -L${TIMCOMLIBPATH} -ltimcom \
                   -L${CWBGFSLIBPATH} -ltcogfs -lmod_ndslfv_monoadv_gpu \
                   -L${COUPLERPATH} -lcpl ${LIBS}
    DRIVER_SRC = driver_gpu_2cpl_TCo383.F90
else
    $(error "Unsupported FRAME value: $(FRAME). Use 4cpl or 2cpl")
endif

F90LINKLIBS= -L$(NVF)/lib -L${CUDA}/lib64 -L${CUDA2} -lcuda -lcusparse -lcudart -lnvf -lmct -lmpeu -lhdf5_hl -lhdf5 -lz -ldl -lblas -llapack \
             -L$(GEPS_LIBS)/x86_64/nceplibs/lib -lw3emc_d -lw3nco_d -lw3nco_4 -lbacio_4 \
             -L/usr/lib/gcc/x86_64-redhat-linux/8/ -lgfortran 

SRCDIR =  src
OBJDIR =  obj
LOGDIR =  log

VPATH= $(SRCDIR)

.SUFFIXES: .F .f .f90 .F90

%.o : %.f90
	$(F90COMPILER) -c $(F90COMPILEOPTS) $(F90COMPILEPATHS) $<

%.o : %.F90
	$(F90COMPILER) -c $(F90COMPILEOPTS) $(F90COMPILEPATHS) $(F90COMPILECPPFLAGS) $<

%.o : %.f
	$(F90COMPILER) -c $(F90COMPILEOPTS) $(F90COMPILEPATHS) $<

%.o : %.F
	$(F90COMPILER) -c $(F90COMPILEOPTS) $(F90COMPILEPATHS) $(F90COMPILECPPFLAGS) $<

SHELL:=/bin/bash

# === 主要目標 ===
all: TCoTIMCOM_$(FRAME)_$(MACHINE)_$(atmres) move

TCoTIMCOM_$(FRAME)_$(MACHINE)_$(atmres): $(DRIVER_SRC:.F90=.o)
	$(F90LINKER) -o $@ $^ $(F90LINKOPTS) $(F90LINKPATHS) $(F90LINKLIBS)

move:
	test -d ${OBJDIR} || mkdir ${OBJDIR}
	mv -f  *.o ./$(OBJDIR)

# === 清理區 ===
.PHONY: dust clean distclean
dust:
	rm -f *.exe

clean:
	rm -f ./obj/*.o ./obj/*.mod *.log TCoTIMCOM_$(FRAME)_$(MACHINE)_$(atmres)

distclean: dust clean

